{
  "name": "floating-notes-pro",
  "version": "1.0.12",
  "description": "Floating Notes Desktop",
  "author": "Kaio H. Diniz",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.kaio.floatingnotes",
    "productName": "Floating Notes Pro",
    "files": [
      "**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "KaiquEdiniz2287",
        "repo": "floating-notes-pro"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerSidebar": "assets/sidebar.bmp",
      "installerHeader": "assets/header.bmp",
      "installerIcon": "assets/icon-instal.ico",
      "uninstallerIcon": "assets/icon-unistal.ico",
      "shortcutName": "Floating Notes Pro"
    },
    "forceCodeSigning": false
  },
  "devDependencies": {
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "dictionary-pt-br": "^2.0.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "nspell": "^2.1.5"
  }
}
